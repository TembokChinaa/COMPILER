<body>
<div class="app">

  <div class="bar">
    <span class="dot"></span>
    <span class="logo">root@mobile ~</span>
  </div>

  <div class="tabs">
    <button class="tab on" data-t="html">HTML</button>
    <button class="tab" data-t="css">CSS</button>
    <button class="tab" data-t="js">JS</button>
    <button class="tab" data-t="view">VIEW</button>
    <button class="tab" data-t="con">LOG</button>
  </div>

  <div class="body">

    <div class="pane on" id="p-html">
      <div class="snip">
        <button onclick="ins('html','<div></div>')">&lt;div&gt;</button>
        <button onclick="ins('html','<button></button>')">&lt;btn&gt;</button>
        <button onclick="ins('html','<p></p>')">&lt;p&gt;</button>
        <button onclick="ins('html','<h1></h1>')">&lt;h1&gt;</button>
        <button onclick="ins('html','<input type=&quot;text&quot;>')">&lt;input&gt;</button>
        <button onclick="ins('html','<img src=&quot;&quot; alt=&quot;&quot;>')">&lt;img&gt;</button>
      </div>
      <textarea class="ta" id="html" spellcheck="false" placeholder="<!-- HTML -->"></textarea>
    </div>

    <div class="pane" id="p-css">
      <div class="snip">
        <button onclick="ins('css','color:#fff;')">color</button>
        <button onclick="ins('css','background:#000;')">bg</button>
        <button onclick="ins('css','display:flex;')">flex</button>
        <button onclick="ins('css','padding:10px;')">pad</button>
        <button onclick="ins('css','margin:10px;')">mrg</button>
        <button onclick="ins('css','border-radius:8px;')">radius</button>
      </div>
      <textarea class="ta" id="css" spellcheck="false" placeholder="/* CSS */"></textarea>
    </div>

    <div class="pane" id="p-js">
      <div class="snip">
        <button onclick="ins('js','console.log();')">log</button>
        <button onclick="ins('js','function f(){\n  \n}')">func</button>
        <button onclick="ins('js','document.querySelector(\'\')')">query</button>
        <button onclick="ins('js','addEventListener(\'click\',()=>{\n  \n})')">listen</button>
        <button onclick="ins('js','alert(\'\')')">alert</button>
      </div>
      <textarea class="ta" id="js" spellcheck="false" placeholder="// JS"></textarea>
    </div>

    <div class="pane" id="p-view">
      <iframe id="preview"></iframe>
    </div>

    <div class="pane" id="p-con">
      <div class="con" id="con">
        <div class="log info"><span class="t">$</span>Compiler siap</div>
      </div>
    </div>

  </div>

  <div class="act">
    <button onclick="clearAll()">🗑</button>
    <button class="run" onclick="run()">▶ RUN</button>
    <button onclick="save()">⬇ SAVE</button>
    <button onclick="help()">?</button>
  </div>

</div>
<div class="toast" id="toast"></div>

<script>
const $ = id => document.getElementById(id);
const H = $('html'), C = $('css'), J = $('js'), P = $('preview'), CON = $('con');

/* ==== DEFAULT CODE ==== */
H.value = `<div class="card">
  <h1>Halo HP! 📱</h1>
  <p>Edit kode, tekan RUN.</p>
  <button onclick="klik()">Klik Aku</button>
</div>`;

C.value = `body{margin:0;padding:20px;min-height:100vh;display:flex;align-items:center;justify-content:center;font-family:system-ui,sans-serif;background:#1a1a2e}
.card{background:#fff;padding:28px 22px;border-radius:14px;text-align:center;max-width:320px;width:100%;box-shadow:0 10px 30px rgba(0,0,0,.3)}
h1{color:#222;margin:0 0 8px;font-size:22px}
p{color:#666;margin:0 0 18px;font-size:14px}
button{background:#238636;color:#fff;border:0;padding:12px 22px;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer}
button:active{transform:scale(.96)}`;

J.value = `function klik(){
  alert("Halo! 🚀");
}
console.log("Siap!");`;

/* ==== TAB SWITCH ==== */
document.querySelectorAll('.tab').forEach(t => {
  t.onclick = () => {
    document.querySelectorAll('.tab').forEach(x => x.classList.remove('on'));
    document.querySelectorAll('.pane').forEach(x => x.classList.remove('on'));
    t.classList.add('on');
    $('p-' + t.dataset.t).classList.add('on');
    if (t.dataset.t === 'view') run();
    if (t.dataset.t === 'con') CON.scrollTop = CON.scrollHeight;
  };
});

/* ==== AUTO RUN (debounce) ==== */
let tm;
[H, C, J].forEach(el => el.addEventListener('input', () => {
  clearTimeout(tm);
  tm = setTimeout(run, 900);
}));

/* ==== RUN ==== */
function run() {
  const proxy = `<script>
(function(){
  const s=(l,a)=>{try{parent.postMessage({t:'c',l:l,m:Array.from(a).map(x=>typeof x==='object'?(()=>{try{return JSON.stringify(x)}catch(e){return String(x)}})():String(x)).join(' ')},'*')}catch(e){}};
  const L=console.log,W=console.warn,E=console.error;
  console.log=(...a)=>{s('log',a);L.apply(console,a)};
  console.warn=(...a)=>s('warn',a);
  console.error=(...a)=>s('error',a);
  window.onerror=(m,_,l)=>s('error',['⚠ '+m+' (line '+l+')']);
})();
<\/script>`;

  const d = P.contentDocument || P.contentWindow.document;
  d.open();
  d.write(`<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>${C.value}</style></head><body>${H.value}${proxy}<script>try{${J.value}}catch(e){console.error('Error: '+e.message)}<\/script></body></html>`);
  d.close();
}

/* ==== CONSOLE LOG ==== */
function log(msg, lv = 'log') {
  const time = new Date().toLocaleTimeString('id-ID', {hour12:false});
  const d = document.createElement('div');
  d.className = 'log ' + (lv === 'error' ? 'err' : lv === 'warn' ? 'warn' : lv === 'info' ? 'info' : 'log-c');
  d.innerHTML = `<span class="t">${time}</span>${esc(msg)}`;
  CON.appendChild(d);
  CON.scrollTop = CON.scrollHeight;
}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}

window.addEventListener('message', e => {
  if (e.data && e.data.t === 'c') log(e.data.m, e.data.l);
});

/* ==== SNIPPET ==== */
function ins(f, txt) {
  const el = $(f);
  const s = el.selectionStart, en = el.selectionEnd;
  el.value = el.value.slice(0, s) + txt + el.value.slice(en);
  el.focus();
  el.selectionStart = el.selectionEnd = s + txt.length;
  toast('Tambah: ' + txt.slice(0, 12));
}

/* ==== CLEAR ==== */
function clearAll() {
  if (!confirm('Hapus semua kode?')) return;
  H.value = C.value = J.value = '';
  run();
  toast('Kode dihapus');
}

/* ==== SAVE ==== */
function save() {
  const full = `<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>My App</title>
<style>
${C.value}
</style>
</head>
<body>
${H.value}
<script>
${J.value}
<\/script>
</body>
</html>`;
  const blob = new Blob([full], {type:'text/html'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'index.html';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(url), 1000);
  toast('File tersimpan!');
}

/* ==== HELP ==== */
function help() {
  document.querySelector('[data-t="con"]').click();
  log('— BANTUAN —', 'info');
  log('Tab HTML/CSS/JS → edit kode');
  log('Tab VIEW → lihat hasil');
  log('Tab LOG → console & error');
  log('RUN → compile manual');
  log('SAVE → download index.html');
  log('Auto-compile aktif 0.9 detik', 'warn');
}

/* ==== TOAST ==== */
let tt;
function toast(m) {
  const el = $('toast');
  el.textContent = m;
  el.classList.add('on');
  clearTimeout(tt);
  tt = setTimeout(() => el.classList.remove('on'), 1400);
}

/* ==== TAB KEY ==== */
[H, C, J].forEach(el => el.addEventListener('keydown', e => {
  if (e.key === 'Tab') {
    e.preventDefault();
    const s = el.selectionStart, en = el.selectionEnd;
    el.value = el.value.slice(0, s) + '  ' + el.value.slice(en);
    el.selectionStart = el.selectionEnd = s + 2;
  }
}));

/* ==== INIT ==== */
setTimeout(run, 200);
</script>
</body>
</html>
