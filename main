.bar .dot{width:8px;height:8px;background:#3fb950;border-radius:50%}
.tabs{display:flex;background:#161b22;border-bottom:1px solid #30363d;flex-shrink:0;overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{flex:1;min-width:70px;padding:10px 4px;background:transparent;border:none;border-bottom:2px solid transparent;color:#8b949e;font:600 11px ui-monospace,monospace;cursor:pointer;letter-spacing:.3px}
