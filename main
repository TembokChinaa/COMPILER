.snip button{flex-shrink:0;padding:5px 10px;background:#21262d;color:#8b949e;border:1px solid #30363d;border-radius:4px;font:11px ui-monospace,monospace;cursor:pointer;white-space:nowrap}
.snip button:active{background:#58a6ff;color:#0d1117;border-color:#58a6ff}
.ta{flex:1;width:100%;background:#0d1117;color:#c9d1d9;border:none;outline:none;resize:none;padding:10px;font:13px/1.5 ui-monospace,Consolas,monospace;tab-size:2;caret-color:#58a6ff;overflow:auto}
.ta::-webkit-scrollbar{width:6px;height:6px}
.ta::-webkit-scrollbar-thumb{background:#30363d;border-radius:3px}
.ta::-webkit-scrollbar-track{background:#0d1117}
.ta::placeholder{color:#484f58}
iframe{flex:1;width:100%;border:none;background:#fff}
.con{flex:1;background:#0d1117;padding:10px;overflow-y:auto;font:12px/1.6 ui-monospace,monospace}
.con::-webkit-scrollbar{width:6px}
